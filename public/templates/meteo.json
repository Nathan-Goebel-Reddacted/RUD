          "dataPath": "$.current.wind_speed_10m",
          "position": { "x": 3, "y": 0, "w": 3, "h": 3 },
          "config": { "type": "number-card", "unit": "km/h", "decimalPlaces": 0 }
        },
        {
          "id": "w1000000-0000-0000-0000-000000000003",
          "label": "Humidité",
          "connectionId": "c1000000-0000-0000-0000-000000000001",
          "endpointId": "e1000000-0000-0000-0000-000000000001",
          "dataPath": "$.current.relative_humidity_2m",
          "position": { "x": 6, "y": 0, "w": 6, "h": 3 },

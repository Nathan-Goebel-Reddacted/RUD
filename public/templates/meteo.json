      "authType": "NONE",
      "authValue": "",
      "headers": {},
      "healthCheckEndpointId": null,
      "endpoints": [
        {
          "id": "e1000000-0000-0000-0000-000000000001",
          "label": "Météo actuelle",
          "path": "/v1/forecast",
          "method": "GET",
          "pathParams": [],
          "queryParams": [
            { "name": "latitude",  "type": "string", "required": true, "defaultValue": "{{lat}}" },
            { "name": "longitude", "type": "string", "required": true, "defaultValue": "{{lon}}" },
            { "name": "current",   "type": "string", "required": true, "defaultValue": "temperature_2m,wind_speed_10m,relative_humidity_2m,precipitation,weather_code" }
          ],
          "responseDataPath": "",
          "body": "",
          "bodyContentType": "application/json"
        }
      ]
    }
  ],
  "dashboards": [
    {
      "id": "d1000000-0000-0000-0000-000000000001",
      "title": "Météo Paris",
      "refreshInterval": 60,
      "showInDisplay": true,
      "widgets": [
        {
          "id": "w1000000-0000-0000-0000-000000000001",
          "label": "Température",
          "connectionId": "c1000000-0000-0000-0000-000000000001",
          "endpointId": "e1000000-0000-0000-0000-000000000001",
          "dataPath": "$.current.temperature_2m",
          "position": { "x": 0, "y": 0, "w": 3, "h": 3 },
          "config": { "type": "number-card", "unit": "°C", "decimalPlaces": 1 }
        },
        {
          "id": "w1000000-0000-0000-0000-000000000002",
